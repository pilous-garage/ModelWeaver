{
  "$schema": "https://modelweaver.dev/schemas/layout.json",
  "id": "agentIde",
  "label": "Agent IDE",
  "icon": "terminal",
  "theme": "dark",
  "menu": [
    {
      "id": "file",
      "label": "Fichier",
      "items": [
        {
          "id": "new-agent",
          "label": "Nouvel agent",
          "action": "panel:ide:new-agent"
        },
        {
          "id": "new-skill",
          "label": "Nouveau skill",
          "action": "panel:ide:new-skill"
        },
        {
          "type": "separator"
        },
        {
          "id": "save-layout",
          "label": "Enregistrer le layout",
          "shortcut": "Ctrl+S",
          "action": "layout:save"
        },
        {
          "type": "separator"
        },
        {
          "id": "close-window",
          "label": "Fermer",
          "shortcut": "Ctrl+W",
          "action": "window:close"
        }
      ]
    },
    {
      "id": "view",
      "label": "Affichage",
      "items": [
        {
          "id": "panels",
          "label": "Panneaux",
          "type": "panel-toggle"
        },
        {
          "type": "separator"
        },
        {
          "id": "fullscreen",
          "label": "Plein écran",
          "shortcut": "F11",
          "action": "window:fullscreen"
        }
      ]
    },
    {
      "id": "theme",
      "label": "Thème",
      "items": [
        {
          "id": "theme-dark",
          "label": "Sombre",
          "action": "theme:set",
          "value": "dark"
        }
      ]
    }
  ],
  "panelTree": {
    "type": "group",
    "groupId": "pg-ide",
    "tabs": [
      "sandbox-agent-ide"
    ],
    "activeTab": "sandbox-agent-ide",
    "visible": true,
    "closable": false
  }
}