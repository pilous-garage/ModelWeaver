{
  "$schema": "https://modelweaver.dev/schemas/layout.json",
  "id": "sandbox",
  "label": "Agent Sandbox",
  "icon": "terminal",
  "theme": "dark",
  "menu": [
    { "id": "file", "label": "Fichier", "items": [
      { "id": "save-layout", "label": "Enregistrer le layout", "shortcut": "Ctrl+S", "action": "layout:save" },
      { "type": "separator" },
      { "id": "close-window", "label": "Fermer", "shortcut": "Ctrl+W", "action": "window:close" }
    ]},
    { "id": "view", "label": "Affichage", "items": [
      { "id": "panels", "label": "Panneaux", "type": "panel-toggle" },
      { "type": "separator" },
      { "id": "fullscreen", "label": "Plein écran", "shortcut": "F11", "action": "window:fullscreen" }
    ]},
    { "id": "theme", "label": "Thème", "items": [
      { "id": "theme-dark", "label": "Sombre", "action": "theme:set", "value": "dark" }
    ]}
  ],
  "panelTree": {
    "direction": "horizontal",
    "sizes": [300, 100],
    "children": [
      { "direction": "vertical", "sizes": [40, 60],
        "children": [
          { "type": "panel", "id": "agents-composition-equipe", "visible": true, "closable": true },
          { "type": "panel", "id": "gestion-bundles", "visible": true, "closable": true }
        ]
      },
      { "direction": "vertical", "sizes": [70, 30],
        "children": [
          { "type": "panel", "id": "communication-chat", "visible": true, "closable": false },
          { "direction": "horizontal", "sizes": [50, 50],
            "children": [
              { "type": "panel", "id": "gestion-outils", "visible": true, "closable": true },
              { "type": "panel", "id": "systeme-llm-locaux", "visible": true, "closable": true }
            ]
          }
        ]
      }
    ]
  }
}
